{
  "name": "squiggle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A private, on-device AI agent in your browser, with sessions synced through your own GitHub repo.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:split": "node tests/e2e/run.mjs --split",
    "check": "npm run lint && npm test",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@isomorphic-git/lightning-fs": "4.10.3",
    "dompurify": "3.4.17",
    "esbuild": "0.25.10",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "isomorphic-git": "1.44.5",
    "just-bash": "3.6.0",
    "marked": "18.1.2",
    "wrangler": "^4"
  },
  "engines": {
    "node": ">=20"
  }
}
